{
  "name": "@xfacts/agentfacts",
  "version": "0.1.1",
  "description": "Validate AGENT_FACTS.md frontmatter against the AgentFacts JSON Schema.",
  "type": "module",
  "scripts": {
    "validate": "node bin/agentfacts.mjs validate",
    "typecheck": "tsc --noEmit",
    "encode-viewer": "node bin/agentfacts.mjs encode-viewer",
    "build": "node scripts/build.mjs src/validate.ts src/encode-viewer.ts",
    "prepack": "pnpm build && node scripts/stage-schema.mjs agent-facts.schema.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7"
    },
    "onlyBuiltDependencies": ["esbuild"]
  },
  "license": "MIT",
  "bin": {
    "agentfacts": "./bin/agentfacts.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "scripts/stage-schema.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/agent-facts.git",
    "directory": "validator"
  },
  "publishConfig": {
    "access": "public"
  }
}
